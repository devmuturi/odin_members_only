<p style="color: green"><%= notice %></p>

<% content_for :title, "Posts" %>

<h1>Posts</h1>

<div class="container my-5">
  <div class="row">
    <% @posts.each do |post| %>
      <div class="col-md-4 mb-4">
        <div class="card h-100">
          <% if post.image.attached? %>
            <%= image_tag post.image.variant(:thumb), class: "card-img-top" %>
          <% end %>
          <div class="card-body">
            <h5 class="card-title"><%= link_to post.title, post_path(post) %></h5>
            <h6 class="card-subtitle mb-2 text-muted"><%= post.user.email if user_signed_in? && post.user.present? %></h6>
            <p class="card-text"><%= post.body %></p>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>


<%= link_to "New post", new_post_path %>
